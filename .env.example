# Backend (copy to backend/.env)
APP_NAME=AffectLab API
ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:5173
PERSISTENCE_BACKEND=mongo
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=affectlab
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
SESSION_RETENTION_DAYS=30
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_TIMEOUT_SECONDS=20
HF_TOKEN=
MULTIMODAL_INFERENCE_ENABLED=false
MULTIMODAL_TEXT_MODEL_DIR=
MULTIMODAL_AUDIO_MODEL_DIR=
MULTIMODAL_CONFIG_PATH=../configs/iemocap_final_multimodal.json
MULTIMODAL_DEVICE=auto
MULTIMODAL_MAX_AUDIO_BYTES=5000000

# Frontend (copy to frontend/.env)
VITE_API_URL=http://localhost:8000/api
